# Copy this file to .env and fill in your own real values.
# .env itself is gitignored -- never commit real credentials.

# Postgres connection (Supabase: Project Settings -> Database -> Connection
# string -> Session pooler tab has all five of these).
DB_USER=postgres.your-project-ref
DB_PASS=your-db-password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# Free API token from https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=your-football-data-org-token
